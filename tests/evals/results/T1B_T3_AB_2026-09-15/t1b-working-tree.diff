 	fmt.Fprintf(&b, "## Claim\n\nAllowed: %t. %s\n\n", agg.Claim.TotalCostClaimAllowed, agg.Claim.Reason)
 
 	fmt.Fprintf(&b, "## Per-task effects\n\n")
