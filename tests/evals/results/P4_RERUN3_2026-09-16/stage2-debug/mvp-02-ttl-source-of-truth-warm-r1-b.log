{"delta":"{\"confidence\": 0.97, \"files\": [{\"base_ref\": \"internal/session/store.go\", \"change_type\": \"modify\", \"edits\": [{\"new\": \"// Len reports how many sessions are held.\\nfunc (s *Store) Len() int {\\n\\ts.mu.RLock()\\n\\tdefer s.mu.RUnlock()\\n\\treturn len(s.sessions)\\n}\\n\\n// Sweep deletes every expired session and reports how many it removed.\\n// Expiry uses the same configured lifetime the rest of the store uses.\\nfunc (s *Store) Sweep() int {\\n\\ts.mu.Lock()\\n\\tdefer s.mu.Unlock()\\n\\tnow := s.now()\\n\\tremoved := 0\\n\\tfor id, session := range s.sessions {\\n\\t\\tif now.Sub(session.LastSeen) \u003e s.ttl {\\n\\t\\t\\tdelete(s.sessions, id)\\n\\t\\t\\tremoved++\\n\\t\\t}\\n\\t}\\n\\treturn removed\\n}\", \"old\": \"// Len reports how many sessions are held.\\nfunc (s *Store) Len() int {\\n\\ts.mu.RLock()\\n\\tdefer s.mu.RUnlock()\\n\\treturn len(s.sessions)\\n}\"}], \"path\": \"internal/session/store.go\"}], \"intent\": \"Add an exported Sweep() int method on session.Store that deletes all sessions idle longer than the store's configured ttl and returns the number removed, using the same expiry check as Get.\", \"language\": \"go\", \"memory_disposition\": []}","id":"call_8aaf4d37df87408c8d075882","runId":"run_20260917161839_164b9d","schemaVersion":2,"type":"tool_call_delta"}
