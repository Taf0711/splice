{"id":"call_raw_file_read_a93a00057dbf4804","name":"raw_file_read","output":"// Command server wires the demo HTTP surface: the admin routes, the\n// password reset flow, and the session store they share.\npackage main\n\nimport (\n\t\"log\"\n\t\"net/http\"\n\n\t\"demo/internal/admin\"\n\t\"demo/internal/auth\"\n\t\"demo/internal/session\"\n)\n\nfunc main() {\n\tstore := session.NewStore(session.DefaultTTL)\n\n\tmux := http.NewServeMux()\n\tmux.Handle(\"/admin/\", admin.NewHandler(store))\n\n\tsvc := auth.NewPasswordService(store)\n\tmux.HandleFunc(\"/reset\", func(w http.ResponseWriter, r *http.Request) {\n\t\tuser := r.URL.Query().Get(\"user\")\n\t\tpass := r.URL.Query().Get(\"password\")\n\t\tif err := svc.ResetPassword(user, pass); err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\tw.WriteHeader(http.StatusOK)\n\t})\n\n\tlog.Println(\"demo server listening on :8080\")\n\tlog.Fatal(http.ListenAndServe(\":8080\", mux))\n}\n","runId":"run_20260917161839_164b9d","schemaVersion":2,"status":"ok","truncated":false,"type":"tool_result"}
