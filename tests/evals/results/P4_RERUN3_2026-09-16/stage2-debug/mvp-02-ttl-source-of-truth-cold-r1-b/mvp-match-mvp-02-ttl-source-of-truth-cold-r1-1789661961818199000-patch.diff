+// Sweep removes every expired session and returns how many it removed.
+// Expiry uses the same ttl the store was configured with.
+func (s *Store) Sweep() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	removed := 0
+	for id, session := range s.sessions {
+		if now.Sub(session.LastSeen) > s.ttl {
+			delete(s.sessions, id)
+			removed++
+		}
+	}
+	return removed
+}
