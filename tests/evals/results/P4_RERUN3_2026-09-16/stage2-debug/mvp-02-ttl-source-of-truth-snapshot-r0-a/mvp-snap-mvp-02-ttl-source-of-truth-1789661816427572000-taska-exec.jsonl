{"args":{"content":"// Command server wires the demo HTTP surface: the admin routes, the\n// password reset flow, and the session store they share.\npackage main\n\nimport (\n\t\"log\"\n\t\"net/http\"\n\n\t\"demo/internal/admin\"\n\t\"demo/internal/auth\"\n\t\"demo/internal/session\"\n)\n\nfunc main() {\n\tstore := session.NewStore(session.DefaultTTL)\n\n\tmux := http.NewServeMux()\n\tmux.Handle(\"/admin/\", admin.NewHandler(store))\n\n\tsvc := auth.NewPasswordService(store)\n\tmux.HandleFunc(\"/reset\", func(w http.ResponseWriter, r *http.Request) {\n\t\tuser := r.URL.Query().Get(\"user\")\n\t\tpass := r.URL.Query().Get(\"password\")\n\t\tif err := svc.ResetPassword(user, pass); err != nil {\n\t\t\thttp.Error(w, err.Error(), http.StatusBadRequest)\n\t\t\treturn\n\t\t}\n\t\tw.WriteHeader(http.StatusOK)\n\t})\n\n\tlog.Println(\"demo server listening on :8080\")\n\tlog.Fatal(http.ListenAndServe(\":8080\", mux))\n}\n","expected_base":"901fb4600bcd630b9087ef055415fa6d41f443ddff1719cd9b1f019927b0a3bf","overwrite":true,"path":"cmd/server/main.go"},"id":"call_write_file_c3ad6c58ea89d85a","name":"write_file","runId":"run_20260917161656_628b54","schemaVersion":2,"sideEffect":"write","type":"tool_call"}
