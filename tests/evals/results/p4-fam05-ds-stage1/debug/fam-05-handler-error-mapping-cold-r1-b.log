{"id":"call_read_file_68dd63ce5696ba53","meta":{"emitted_bytes":"2309","estimated_tokens":"578","raw_bytes":"2309"},"name":"read_file","output":"File: main.go (72 lines)\n\n 1 | package main\n 2 | \n 3 | import (\n 4 | \t\"encoding/json\"\n 5 | \t\"errors\"\n 6 | \t\"log\"\n 7 | \t\"net/http\"\n 8 | \t\"time\"\n 9 | )\n10 | \n11 | func main() {\n12 | \tstore := NewStore(30 * time.Minute)\n13 | \thttp.HandleFunc(\"/session\", sessionHandler(store))\n14 | \thttp.HandleFunc(\"/healthz\", healthHandler(store))\n15 | \tlog.Println(\"listening on :8080\")\n16 | \tlog.Fatal(http.ListenAndServe(\":8080\", nil))\n17 | }\n18 | \n19 | // sessionHandler creates a session on POST and reads one on GET.\n20 | func sessionHandler(store *Store) http.HandlerFunc {\n21 | \treturn func(w http.ResponseWriter, r *http.Request) {\n22 | \t\tswitch r.Method {\n23 | \t\tcase http.MethodPost:\n24 | \t\t\tid := r.URL.Query().Get(\"id\")\n25 | \t\t\tuser := r.URL.Query().Get(\"user\")\n26 | \t\t\tif id == \"\" || user == \"\" {\n27 | \t\t\t\thttp.Error(w, \"id and user are required\", http.StatusBadRequest)\n28 | \t\t\t\treturn\n29 | \t\t\t}\n30 | \t\t\twriteJSON(w, store.Create(id, user))\n31 | \t\tcase http.MethodGet:\n32 | \t\t\tsession, err := store.Get(r.URL.Query().Get(\"id\"))\n33 | \t\t\tif err != nil {\n34 | \t\t\t\thttp.Error(w, err.Error(), mapStoreError(err))\n35 | \t\t\t\treturn\n36 | \t\t\t}\n37 | \t\t\twriteJSON(w, session)\n38 | \t\tdefault:\n39 | \t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n40 | \t\t}\n41 | \t}\n42 | }\n43 | \n44 | // mapStoreError translates store sentinel errors into HTTP status codes.\n45 | func mapStoreError(err error) int {\n46 | \tswitch {\n47 | \tcase errors.Is(err, ErrNotFound):\n48 | \t\treturn http.StatusNotFound\n49 | \tcase errors.Is(err, ErrConflict):\n50 | \t\treturn http.StatusConflict\n51 | \tcase errors.Is(err, ErrInvalidID):\n52 | \t\treturn http.StatusBadRequest\n53 | \tcase errors.Is(err, ErrUserAtCap):\n54 | \t\treturn http.StatusTooManyRequests\n55 | \tdefault:\n56 | \t\treturn http.StatusInternalServerError\n57 | \t}\n58 | }\n59 | \n60 | // healthHandler reports how many sessions are currently held.\n61 | func healthHandler(store *Store) http.HandlerFunc {\n62 | \treturn func(w http.ResponseWriter, r *http.Request) {\n63 | \t\twriteJSON(w, map[string]int{\"sessions\": store.Len()})\n64 | \t}\n65 | }\n66 | \n67 | func writeJSON(w http.ResponseWriter, payload any) {\n68 | \tw.Header().Set(\"Content-Type\", \"application/json\")\n69 | \tif err := json.NewEncoder(w).Encode(payload); err != nil {\n70 | \t\tlog.Printf(\"write response: %v\", err)\n71 | \t}\n72 | }","runId":"run_20260918154738_b9e671","schemaVersion":2,"status":"ok","truncated":false,"type":"tool_result"}
