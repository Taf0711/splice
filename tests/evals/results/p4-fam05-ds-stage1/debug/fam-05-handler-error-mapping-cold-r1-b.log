{"args":{"content":"package main\n\nimport (\n\t\"net/http\"\n)\n\n// adminHandler exposes administrative operations over sessions. Every store\n// error is translated through mapStoreError so the store-error-to-status\n// table in main.go stays the single source of truth.\nfunc adminHandler(store *Store) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tswitch r.Method {\n\t\tcase http.MethodGet:\n\t\t\tsession, err := store.Get(r.URL.Query().Get(\"id\"))\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, err.Error(), mapStoreError(err))\n\t\t\t\treturn\n\t\t\t}\n\t\t\twriteJSON(w, session)\n\t\tcase http.MethodDelete:\n\t\t\tid := r.URL.Query().Get(\"id\")\n\t\t\tif id == \"\" {\n\t\t\t\thttp.Error(w, \"id is required\", mapStoreError(ErrInvalidID))\n\t\t\t\treturn\n\t\t\t}\n\t\t\tstore.Delete(id)\n\t\t\twriteJSON(w, map[string]string{\"status\": \"deleted\", \"id\": id})\n\t\tdefault:\n\t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n\t\t}\n\t}\n}\n\n// adminStatsHandler reports aggregate store statistics.\nfunc adminStatsHandler(store *Store) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tif r.Method != http.MethodGet {\n\t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n\t\t\treturn\n\t\t}\n\t\twriteJSON(w, map[string]int{\"sessions\": store.Len()})\n\t}\n}\n","overwrite":true,"path":"admin.go"},"id":"call_write_file_e3cc0840b84c0af2","name":"write_file","runId":"run_20260918154738_b9e671","schemaVersion":2,"sideEffect":"write","type":"tool_call"}
