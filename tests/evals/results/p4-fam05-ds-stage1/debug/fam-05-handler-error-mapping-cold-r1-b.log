ed\n58 | // session is dropped and reported as missing.\n59 | func (s *Store) Get(id string) (Session, error) {\n60 | \ts.mu.Lock()\n61 | \tdefer s.mu.Unlock()\n62 | \tsession, ok := s.sessions[id]\n63 | \tif !ok {\n64 | \t\treturn Session{}, ErrNotFound\n65 | \t}\n66 | \tif s.now().Sub(session.LastSeen) \u003e s.ttl {\n67 | \t\tdelete(s.sessions, id)\n68 | \t\treturn Session{}, ErrNotFound\n69 | \t}\n70 | \tsession.LastSeen = s.now()\n71 | \ts.sessions[id] = session\n72 | \treturn session, nil\n73 | }\n74 | \n75 | // Delete removes a session. Deleting an unknown id is not an error.\n76 | func (s *Store) Delete(id string) {\n77 | \ts.mu.Lock()\n78 | \tdefer s.mu.Unlock()\n79 | \tdelete(s.sessions, id)\n80 | }\n81 | \n82 | // Len reports how many sessions are held.\n83 | func (s *Store) Len() int {\n84 | \ts.mu.RLock()\n85 | \tdefer s.mu.RUnlock()\n86 | \treturn len(s.sessions)\n87 | }","runId":"run_20260918154738_b9e671","schemaVersion":2,"status":"ok","truncated":false,"type":"tool_result"}
