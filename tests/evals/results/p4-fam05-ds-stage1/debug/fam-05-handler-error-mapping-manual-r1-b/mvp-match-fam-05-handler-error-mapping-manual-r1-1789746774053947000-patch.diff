+// adminSessionsHandler is the admin view over the same store. It deletes a
+// session on DELETE and looks one up on GET, translating every store error
+// through the shared mapStoreError table.
+func adminSessionsHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			session, err := store.Get(r.URL.Query().Get("id"))
+			if err != nil {
+				http.Error(w, err.Error(), mapStoreError(err))
+				return
+			}
+			writeJSON(w, session)
+		case http.MethodDelete:
+			store.Delete(r.URL.Query().Get("id"))
+			writeJSON(w, map[string]string{"status": "deleted"})
+		default:
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		}
+	}
+}
