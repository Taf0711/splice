+// adminHandler exposes administrative session operations. Every store error
+// is translated through mapStoreError so the mapping table remains the single
+// source of truth for store-error-to-status translation.
+func adminHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		id := r.URL.Query().Get("id")
+		switch r.Method {
+		case http.MethodGet:
+			session, err := store.Get(id)
+			if err != nil {
+				http.Error(w, err.Error(), mapStoreError(err))
+				return
+			}
+			writeJSON(w, session)
+		case http.MethodDelete:
+			if _, err := store.Get(id); err != nil {
+				http.Error(w, err.Error(), mapStoreError(err))
+				return
+			}
+			store.Delete(id)
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		}
+	}
+}
