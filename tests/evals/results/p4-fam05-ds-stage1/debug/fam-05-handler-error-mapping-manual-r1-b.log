{"args":{"content":"package main\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"log\"\n\t\"net/http\"\n\t\"time\"\n)\n\nfunc main() {\n\tstore := NewStore(30 * time.Minute)\n\thttp.HandleFunc(\"/session\", sessionHandler(store))\n\thttp.HandleFunc(\"/admin/sessions\", adminSessionsHandler(store))\n\thttp.HandleFunc(\"/healthz\", healthHandler(store))\n\tlog.Println(\"listening on :8080\")\n\tlog.Fatal(http.ListenAndServe(\":8080\", nil))\n}\n\n// sessionHandler creates a session on POST and reads one on GET.\nfunc sessionHandler(store *Store) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tswitch r.Method {\n\t\tcase http.MethodPost:\n\t\t\tid := r.URL.Query().Get(\"id\")\n\t\t\tuser := r.URL.Query().Get(\"user\")\n\t\t\tif id == \"\" || user == \"\" {\n\t\t\t\thttp.Error(w, \"id and user are required\", http.StatusBadRequest)\n\t\t\t\treturn\n\t\t\t}\n\t\t\twriteJSON(w, store.Create(id, user))\n\t\tcase http.MethodGet:\n\t\t\tsession, err := store.Get(r.URL.Query().Get(\"id\"))\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, err.Error(), mapStoreError(err))\n\t\t\t\treturn\n\t\t\t}\n\t\t\twriteJSON(w, session)\n\t\tdefault:\n\t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n\t\t}\n\t}\n}\n\n// mapStoreError translates store sentinel errors into HTTP status codes.\nfunc mapStoreError(err error) int {\n\tswitch {\n\tcase errors.Is(err, ErrNotFound):\n\t\treturn http.StatusNotFound\n\tcase errors.Is(err, ErrConflict):\n\t\treturn http.StatusConflict\n\tcase errors.Is(err, ErrInvalidID):\n\t\treturn http.StatusBadRequest\n\tcase errors.Is(err, ErrUserAtCap):\n\t\treturn http.StatusTooManyRequests\n\tdefault:\n\t\treturn http.StatusInternalServerError\n\t}\n}\n\n// adminSessionsHandler is the admin view over the same store. It deletes a\n// session on DELETE and looks one up on GET, translating every store error\n// through the shared mapStoreError table.\nfunc adminSessionsHandler(store *Store) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\tswitch r.Method {\n\t\tcase http.MethodGet:\n\t\t\tsession, err := store.Get(r.URL.Query().Get(\"id\"))\n\t\t\tif err != nil {\n\t\t\t\thttp.Error(w, err.Error(), mapStoreError(err))\n\t\t\t\treturn\n\t\t\t}\n\t\t\twriteJSON(w, session)\n\t\tcase http.MethodDelete:\n\t\t\tstore.Delete(r.URL.Query().Get(\"id\"))\n\t\t\twriteJSON(w, map[string]string{\"status\": \"deleted\"})\n\t\tdefault:\n\t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n\t\t}\n\t}\n}\n\n// healthHandler reports how many sessions are currently held.\nfunc healthHandler(store *Store) http.HandlerFunc {\n\treturn func(w http.ResponseWriter, r *http.Request) {\n\t\twriteJSON(w, map[string]int{\"sessions\": store.Len()})\n\t}\n}\n\nfunc writeJSON(w http.ResponseWriter, payload any) {\n\tw.Header().Set(\"Content-Type\", \"application/json\")\n\tif err := json.NewEncoder(w).Encode(payload); err != nil {\n\t\tlog.Printf(\"write response: %v\", err)\n\t}\n}\n","expected_base":"0152d356fd19d8bacc4fc66edc05e57e9b9596f0f27fbd097418d82548935171","overwrite":true,"path":"main.go"},"id":"call_write_file_41eca01979246769","name":"write_file","runId":"run_20260918155254_8ae854","schemaVersion":2,"sideEffect":"write","type":"tool_call"}
