@@ -0,0 +1,43 @@
+package main
+
+import (
+	"net/http"
+)
+
+// adminHandler exposes administrative operations over sessions. Every store
+// error is translated through mapStoreError so the store-error-to-status
+// table in main.go stays the single source of truth.
+func adminHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			session, err := store.Get(r.URL.Query().Get("id"))
+			if err != nil {
+				http.Error(w, err.Error(), mapStoreError(err))
+				return
+			}
+			writeJSON(w, session)
+		case http.MethodDelete:
+			id := r.URL.Query().Get("id")
+			if id == "" {
+				http.Error(w, "id is required", mapStoreError(ErrInvalidID))
+				return
+			}
+			store.Delete(id)
+			writeJSON(w, map[string]string{"status": "deleted", "id": id})
+		default:
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		}
+	}
+}
+
+// adminStatsHandler reports aggregate store statistics.
+func adminStatsHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writeJSON(w, map[string]int{"sessions": store.Len()})
+	}
+}
