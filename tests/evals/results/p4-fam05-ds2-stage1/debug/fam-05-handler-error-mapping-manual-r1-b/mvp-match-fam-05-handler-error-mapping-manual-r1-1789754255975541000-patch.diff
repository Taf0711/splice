+package main
+
+import (
+	"net/http"
+)
+
+// adminSessionHandler exposes admin session operations. It maps store errors
+// through the shared mapStoreError table so the /session handler and admin
+// endpoints translate store errors identically.
+func adminSessionHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			session, err := store.Get(r.URL.Query().Get("id"))
+			if err != nil {
+				http.Error(w, err.Error(), mapStoreError(err))
+				return
+			}
+			writeJSON(w, session)
+		case http.MethodDelete:
+			id := r.URL.Query().Get("id")
+			if id == "" {
+				http.Error(w, "id is required", mapStoreError(ErrInvalidID))
+				return
+			}
+			store.Delete(id)
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		}
+	}
+}
+
+// adminSessionsHandler lists every live session for administrators.
+func adminSessionsHandler(store *Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		writeJSON(w, map[string]int{"sessions": store.Len()})
+	}
+}
