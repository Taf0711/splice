{"delta":"{\"files\": [{\"path\": \"admin.go\", \"change_type\": \"create\", \"content\": \"package main\\n\\nimport (\\n\\t\\\"net/http\\\"\\n)\\n\\n// adminSessionHandler exposes admin session operations. It maps store errors\\n// through the shared mapStoreError table so the /session handler and admin\\n// endpoints translate store errors identically.\\nfunc adminSessionHandler(store *Store) http.HandlerFunc {\\n\\treturn func(w http.ResponseWriter, r *http.Request) {\\n\\t\\tswitch r.Method {\\n\\t\\tcase http.MethodGet:\\n\\t\\t\\tsession, err := store.Get(r.URL.Query().Get(\\\"id\\\"))\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\thttp.Error(w, err.Error(), mapStoreError(err))\\n\\t\\t\\t\\treturn\\n\\t\\t\\t}\\n\\t\\t\\twriteJSON(w, session)\\n\\t\\tcase http.MethodDelete:\\n\\t\\t\\tid := r.URL.Query().Get(\\\"id\\\")\\n\\t\\t\\tif id == \\\"\\\" {\\n\\t\\t\\t\\thttp.Error(w, \\\"id is required\\\", mapStoreError(ErrInvalidID))\\n\\t\\t\\t\\treturn\\n\\t\\t\\t}\\n\\t\\t\\tstore.Delete(id)\\n\\t\\t\\tw.WriteHeader(http.StatusNoContent)\\n\\t\\tdefault:\\n\\t\\t\\thttp.Error(w, \\\"method not allowed\\\", http.StatusMethodNotAllowed)\\n\\t\\t}\\n\\t}\\n}\\n\\n// adminSessionsHandler lists every live session for administrators.\\nfunc adminSessionsHandler(store *Store) http.HandlerFunc {\\n\\treturn func(w http.ResponseWriter, r *http.Request) {\\n\\t\\tif r.Method != http.MethodGet {\\n\\t\\t\\thttp.Error(w, \\\"method not allowed\\\", http.StatusMethodNotAllowed)\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t\\twriteJSON(w, map[string]int{\\\"sessions\\\": store.Len()})\\n\\t}\\n}\\n\"}, {\"path\": \"main.go\", \"change_type\": \"modify\", \"base_ref\": \"main.go\", \"edits\": [{\"old\": \"\\thttp.HandleFunc(\\\"/session\\\", sessionHandler(store))\\n\\thttp.HandleFunc(\\\"/healthz\\\", healthHandler(store))\", \"new\": \"\\thttp.HandleFunc(\\\"/session\\\", sessionHandler(store))\\n\\thttp.HandleFunc(\\\"/admin/session\\\", adminSessionHandler(store))\\n\\thttp.HandleFunc(\\\"/admin/sessions\\\", adminSessionsHandler(store))\\n\\thttp.HandleFunc(\\\"/healthz\\\", healthHandler(store))\"}]}], \"language\": \"go\", \"intent\": \"Add admin endpoints that translate store errors via the existing shared mapStoreError table in main.go, keeping it the single source of truth for store-error-to-status mapping.\", \"confidence\": 0.85, \"known_limitations\": [\"No test_generator stage follows in pipeline_stages; admin handler behavior is not covered by new tests.\", \"adminSessionHandler/sessions are self-contained and use only existing Store and mapStoreError symbols.\"]}","id":"chatcmpl-tool-2acd27afbd8a4f08850c3da24f33b96b","runId":"run_20260918175736_d009dc","schemaVersion":2,"type":"tool_call_delta"}
