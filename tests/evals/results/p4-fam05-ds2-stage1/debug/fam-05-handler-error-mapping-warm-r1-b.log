urn http.StatusBadRequest\n54 | \tcase errors.Is(err, ErrUserAtCap):\n55 | \t\treturn http.StatusTooManyRequests\n56 | \tdefault:\n57 | \t\treturn http.StatusInternalServerError\n58 | \t}\n59 | }\n60 | \n61 | // adminDeleteSessionHandler deletes a session on DELETE.\n62 | func adminDeleteSessionHandler(store *Store) http.HandlerFunc {\n63 | \treturn func(w http.ResponseWriter, r *http.Request) {\n64 | \t\tif r.Method != http.MethodDelete {\n65 | \t\t\thttp.Error(w, \"method not allowed\", http.StatusMethodNotAllowed)\n66 | \t\t\treturn\n67 | \t\t}\n68 | \t\tif err := store.Delete(r.URL.Query().Get(\"id\")); err != nil {\n69 | \t\t\thttp.Error(w, err.Error(), mapStoreError(err))\n70 | \t\t\treturn\n71 | \t\t}\n72 | \t\tw.WriteHeader(http.StatusNoContent)\n73 | \t}\n74 | }\n75 | \n76 | // healthHandler reports how many sessions are currently held.\n77 | func healthHandler(store *Store) http.HandlerFunc {\n78 | \treturn func(w http.ResponseWriter, r *http.Request) {\n79 | \t\twriteJSON(w, map[string]int{\"sessions\": store.Len()})\n80 | \t}\n81 | }\n82 | \n83 | func writeJSON(w http.ResponseWriter, payload any) {\n84 | \tw.Header().Set(\"Content-Type\", \"application/json\")\n85 | \tif err := json.NewEncoder(w).Encode(payload); err != nil {\n86 | \t\tlog.Printf(\"write response: %v\", err)\n87 | \t}\n88 | }","runId":"run_20260918175717_2c2313","schemaVersion":2,"status":"ok","truncated":false,"type":"tool_result"}
